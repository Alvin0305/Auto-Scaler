{
  "qemuURL": "qemu:///system",
  "defaultStoragePoolName": "default",
  "defaultStoragePoolPath": "/var/lib/libvirt/images/",
  "diskImageFileExtension": ".qcow2",
  "loadBalancer": {
    "ip": "127.0.0.1",
    "port": 8000
  },
  "VMs": {
    "baseVMName": "ubuntu-base",
    "server1VMName": "server1",
    "server2VMName": "server2"
  },
  "workerPort": 8080,
  "monitoringInterval": 5,
  "minCPUUsageThreshold": 40,
  "maxCPUUsageThreshold": 70,
  "peakCountForTrigger": 3,
  "work": {
    "work": "fibonacci",
    "intervalInLowLoad": 1000,
    "intervalInHighLoad": 100,
    "valueStartInLowLoad": 10,
    "valueStartInHighLoad": 20,
    "valueEndInLowLoad": 15,
    "valueEndInHighLoad": 30
  }
}
